#!/usr/bin/env sh

# ── Global yabai config ──────────────────────────────────────
yabai -m config                                 \
    external_bar                 off:40:0       \
    menubar_opacity              1.0            \
    mouse_follows_focus          off            \
    focus_follows_mouse          off            \
    display_arrangement_order    default        \
    window_origin_display        default        \
    window_placement             second_child   \
    window_insertion_point       focused        \
    window_zoom_persist          on             \
    window_shadow                on             \
    skip_window_focus_animation  off            \
    window_animation_duration    0.0            \
    window_animation_easing      ease_out_circ  \
    window_opacity_duration      0.0            \
    active_window_opacity        1.0            \
    normal_window_opacity        0.90           \
    window_opacity               off            \
    insert_feedback_color        0xffd75f5f     \
    split_ratio                  0.50           \
    split_type                   auto           \
    auto_balance                 on             \
    top_padding                  12             \
    bottom_padding               12             \
    left_padding                 12             \
    right_padding                12             \
    window_gap                   06             \
    layout                       bsp            \
    mouse_modifier               fn             \
    mouse_action1                move           \
    mouse_action2                resize         \
    mouse_drop_action            swap

# ── Real utility/dialog app exceptions (never tiled, anywhere) ─
# NOTE: don't use subrole="^AXDialog$" as a blanket rule — some
# full app main windows (CloakBrowser Manager, Clearly) report
# AXDialog as their subrole and would get wrongly excluded.
yabai -m rule --add app="^System Settings$"     manage=off
yabai -m rule --add app="^System Information$"  manage=off
yabai -m rule --add app="^Archive Utility$"     manage=off
yabai -m rule --add app="^Tailscale$"           manage=off
yabai -m rule --add app="^1Password$"           manage=off
yabai -m rule --add app="^QuickTime Player$"    manage=off
yabai -m rule --add app="^Finder$" title="(Copy|Move|Trash|Delete|Info|Preferences)" manage=off
yabai -m rule --add role="^AXPopover$"          manage=off

# ── Per-space layout: only the rightmost display tiles ─────────
# display 2 (yabai index, physical rightmost monitor) = bsp (tiled)
# display 1 (center) and display 3 (left/laptop)      = float
yabai -m space 1 --layout float 2>/dev/null
yabai -m space 3 --layout float 2>/dev/null
yabai -m space 2 --layout bsp   2>/dev/null

# Keep new spaces correctly floating/tiling based on which display
# they land on (covers Mission Control adding spaces later).
yabai -m signal --add event=space_created \
    action="/Users/pmac/Documents/GitHub/tiler/scripts/handle-space-created.sh"

# ── New-window handling ─────────────────────────────────────────
# Every new window (any app, unless in the exception list above)
# gets moved to display 2 and force-tiled.
yabai -m signal --add event=window_created \
    action="/Users/pmac/Documents/GitHub/tiler/scripts/handle-new-window.sh"

# ── Fix stale/never-tiled windows from before this config ran ──
/Users/pmac/Documents/GitHub/tiler/scripts/retile-all.sh >/tmp/yabai_retile.log 2>&1 &

echo "yabai configuration loaded.."
